<div class="modal fade show" id="myModal" style="display:block; background-color: rgba(10,10,10,.8);" 
     aria-modal="true" 
     role="dialog">
    <div class="modal-dialog" style="max-width: 99%; width: 80%;">
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title">@Title</h4>
                <button type="button" class="dialogClose" aria-label="@L["Button.Close"]"
                        @onclick="@ModalCancel">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>
            <div class="modal-body" style="max-height:95%;">
                @ChildContent
            </div>
            <div class="modal-footer">
                @switch (DialogType)
                {
                    case ModalDialogType.Ok:
                        <button type="button" class="btn btn-primary" @onclick=@ModalOk>@ConfirmLabel("OK")</button>
                        break;
                    case ModalDialogType.OkCancel:
                        <button type="button" class="btn btn-primary" @onclick=@ModalOk>@ConfirmLabel("OK")</button>
                        <button type="button" class="btn" @onclick="@ModalCancel">@L["Button.Cancel"]</button>
                        break;
                    case ModalDialogType.DeleteCancel:
                        <button type="button" class="btn" @onclick="@ModalCancel">@L["Button.Cancel"]</button>
                        <button type="button" class="btn btn-danger" @onclick=@ModalOk>@ConfirmLabel("Delete")</button>
                        break;
                    case ModalDialogType.SaveDiscardCancel:
                        <button type="button" class="btn" @onclick="@ModalCancel">@L["Button.Cancel"]</button>
                        <button type="button" class="btn btn-danger" @onclick=@ModalDiscard>@DiscardLabel("Discard")</button>
                        <button type="button" class="btn btn-primary" @onclick=@ModalOk>@ConfirmLabel("Save")</button>
                        break;
                }
            </div>
        </div>
    </div>
</div>
