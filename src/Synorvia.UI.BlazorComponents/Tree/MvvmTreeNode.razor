@using Synorvia.UI.DataModels.Tree
@typeparam TNode

<div class="uic-tree-row @(DataContext.IsSelected ? "is-selected" : "")" @onclick="@(() => OnSelectNode(DataContext))">

    <span class="uic-tree__icon-box" @onclick="@(() => OnToggleNode(DataContext, !DataContext.IsExpanded))" @onclick:stopPropagation="true">
        @if (DataContext.Children.Any())
        {
            <svg class="tree-svg @(DataContext.IsExpanded ? "is-expanded" : "")" viewBox="0 0 24 24">
                <polyline points="9 18 15 12 9 6"></polyline>
            </svg>
        }
    </span>

    @if (ShowTreeIcons)
    {
        var symbol = GetTypeSymbol();
        if (!string.IsNullOrEmpty(symbol))
        {
            <span class="uic-mono-icon">@symbol</span>
        }
    }

    <span class="uic-tree__title">@TitleTemplate((TNode)DataContext)</span>
</div>

@if (DataContext.IsExpanded)
{
    <div class="uic-tree__children">
        @foreach (TNode node in DataContext.Children)
        {
            <MvvmTreeNode @key="node"
                  TNode="TNode"
                  DataContext="(ITreeNode)node"
                  TitleTemplate="TitleTemplate"
                  Style="Style"
                  ShowTreeIcons="ShowTreeIcons"
                  TypeSymbolSelector="TypeSymbolSelector" />

        }
    </div>
}